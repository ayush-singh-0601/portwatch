# PortWatch Environment Configuration
# Copy this file to .env and fill in your values

# Database
DB_PASSWORD=portwatch_dev_password
DATABASE_URL=postgresql+asyncpg://portwatch:${DB_PASSWORD}@localhost:5432/portwatch

# AIS Data Source
AISSTREAM_API_KEY=your_aisstream_api_key_here
# Sign up free at https://aisstream.io

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Mock Data Mode (set to true to use synthetic data without external APIs)
MOCK_DATA_MODE=true

# LLM Integration (optional, for report narrative generation)
# LLM_PROVIDER=gemini
# LLM_API_KEY=your_api_key_here

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
